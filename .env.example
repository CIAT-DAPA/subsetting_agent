# ---------------------------------------------------------------------------
# SubsettingAgent configuration. Copy this file to ".env" and adjust values.
# ---------------------------------------------------------------------------

# --- LLM (served through LiteLLM) -------------------------------------------
# Any LiteLLM model string works, e.g. "ollama_chat/llama3.1:8b", "openai/gpt-4o-mini"
LLM_MODEL=ollama_chat/llama3.1:8b
# Base URL of the model server (Ollama by default). Leave empty for hosted providers.
LLM_API_BASE=http://localhost:11434
# API key for hosted providers. Not needed for Ollama.
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
# Context window requested from Ollama models.
LLM_NUM_CTX=8192

# --- Agent behaviour ----------------------------------------------------------
# Maximum number of LLM <-> tool iterations allowed per user message.
AGENT_MAX_ITERATIONS=15
# Number of recent chat messages sent back to the model as conversation memory.
AGENT_MAX_HISTORY_MESSAGES=20
# Number of Candidate list rows shown in every response preview.
AGENT_PREVIEW_ROWS=15

# --- Gradio application -------------------------------------------------------
APP_HOST=localhost
APP_PORT=7860

# --- Sessions -----------------------------------------------------------------
# Single root folder for temporary files. One sub folder per session is created inside.
TMP_DIR=tmp

# --- External APIs (consumed through the SDKs) --------------------------------
# Production: https://api.genesys-pgr.org | Sandbox: https://api.sandbox.genesys-pgr.org
GENESYS_API_URL=https://api.genesys-pgr.org
# Personal API token (sent as "Authorization: API-Token ..."). Preferred method.
GENESYS_API_TOKEN=
# OAuth2 client credentials, used only when GENESYS_API_TOKEN is empty.
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
# Records per page (max 1000) and safety cap on records fetched per search.
GENESYS_PAGE_SIZE=500
GENESYS_MAX_RECORDS=5000
GENESYS_TIMEOUT=60
SUBSETTING_API_URL=
OPENALEX_API_URL=https://api.openalex.org
# Email sent to OpenAlex to join the polite pool (optional).
OPENALEX_MAILTO=

# --- Base raster grid used to compute the cellid of each accession ------------
SUBSETTING_GRID_NCOLS=7198
SUBSETTING_GRID_NROWS=2000
SUBSETTING_GRID_XMIN=-180
SUBSETTING_GRID_YMIN=-50
SUBSETTING_GRID_CELLSIZE=0.05

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
