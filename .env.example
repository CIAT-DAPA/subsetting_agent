# --- Subsetting API (climate indicators, clustering) ---
# Base URL of the deployed Subsetting API. The SDK appends the API prefix below.
SUBSETTING_API_URL=https://sandbox.genesys-pgr.org/api/subsetting
# Path prefix of the Flask routes. Set to an empty string if the proxy strips it.
SUBSETTING_API_PREFIX=/api/v1
# HTTP timeout in seconds for a single request (clustering can be slow).
SUBSETTING_API_TIMEOUT=120
# API token required by the deployed API (sent as "Authorization: <scheme> <token>").
# Request it at https://sandbox.genesys-pgr.org/api/subsetting. Leave empty for anonymous access.
SUBSETTING_API_TOKEN=
# Authorization scheme placed before the token. Default matches the Genesys API.
SUBSETTING_API_AUTH_SCHEME=API-Token

# --- Subsetting grid (used to compute cellids for accession spreadsheets) ---
# Defaults match data/builder_indicators/raster_base.asc of the Subsetting API repo.
SUBSETTING_GRID_NCOLS=7198
SUBSETTING_GRID_NROWS=2000
SUBSETTING_GRID_XMIN=-180
SUBSETTING_GRID_YMIN=-50
SUBSETTING_GRID_CELLSIZE=0.05

# --- Genesys PGR REST API (accessions, passport data, traits) ---
GENESYS_API_URL=https://api.sandbox.genesys-pgr.org
# API token, sent as "Authorization: API-Token <token>". Leave empty for anonymous access.
GENESYS_API_TOKEN=
# HTTP timeout in seconds for a single request.
GENESYS_API_TIMEOUT=60
# Dotted path of the accession field that holds the Subsetting API cellid.
# Candidates: geo.tileIndex (default) or tileIndex3min.
GENESYS_CELLID_FIELD=geo.tileIndex
# Maximum number of accessions fetched for one passport filter (pagination cap).
GENESYS_MAX_ACCESSIONS=2000

# --- LLM (served through litellm) ---
SUBSETTING_AGENT_MODEL=ollama_chat/llama3.1:8b
SUBSETTING_AGENT_API_BASE=http://localhost:11434
# Loop limits: LLM calls per turn, tokens per answer, sampling temperature, Ollama context window.
SUBSETTING_AGENT_MAX_ITERATIONS=15
SUBSETTING_AGENT_MAX_TOKENS=1024
SUBSETTING_AGENT_TEMPERATURE=0.1
SUBSETTING_AGENT_NUM_CTX=8192
# Recent chat messages replayed to the model on every turn.
SUBSETTING_AGENT_MAX_HISTORY=20

# --- Gradio ---
SUBSETTING_AGENT_HOST=localhost
SUBSETTING_AGENT_PORT=7860

# --- Storage (all relative to the working directory unless absolute) ---
# Where every attachment (PDF, Excel/CSV) is copied under a stable name
# YYYYMMDD_HHmmss_<hash>.<ext>. Gradio's own cache is temporary.
UPLOADS_DIR=tmp/uploads
# Directory where PDF -> Markdown conversions are cached (YYYYMMDD_HHmmss_<hash>.md).
DOCUMENT_CACHE_DIR=tmp/documents
# Gradio's temporary upload cache; kept inside the project so it is easy to clean.
GRADIO_TEMP_DIR=tmp/gradio_tmp
# Logging level (DEBUG, INFO, WARNING).
SUBSETTING_AGENT_LOG_LEVEL=INFO
